# Comparative experiment D (v2): balanced (no strongly dominant category) dataset, rigor pass
# (see README "Comparative Experiments").
#
# Entirely separate identity/isolation from the v1 balanced profile
# (.env.experiment-balanced.env): different Compose project, different volumes, different
# ports, different EXPERIMENT_ID. v1's volumes/reports are never touched.
#
#   docker compose --env-file .env --env-file .env.experiment-balanced-v2.env up -d
#
# Every value here only *overrides* what .env already sets -- it never replaces .env.

COMPOSE_PROJECT_NAME=machine-learning-comparative-balanced-v2

POSTGRES_VOLUME_NAME=recommendation_postgres_balanced_v2
MODEL_VOLUME_NAME=recommendation_models_balanced_v2
EXPERIMENT_VOLUME_NAME=recommendation_reports_balanced_v2

POSTGRES_CONTAINER_NAME=recommendation-ml-postgres-balanced-v2
APP_CONTAINER_NAME=recommendation-ml-app-balanced-v2

# Distinct from the default stack (3500/6003) and every v1 profile (3510-3513/6010-6013).
PORT=3523
DB_PORT=6023

TRAINING_ALGORITHM_LOCK=LogisticRegression

EXPERIMENT_ID=comparative-balanced-v2
DATASET_VERSION=comparative-balanced-v2
