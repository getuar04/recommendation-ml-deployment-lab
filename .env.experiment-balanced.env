# Comparative experiment D: balanced (no strongly dominant category) dataset (see README
# "Comparative Experiments").
#
#   docker compose --env-file .env --env-file .env.experiment-balanced.env up -d
#
# Every value here only *overrides* what .env already sets -- it never replaces .env.

# CRITICAL: a distinct Compose project name -- see the long comment in
# .env.experiment-sport.env. Without this, Compose can silently recreate (replace) whatever
# container already occupies the "postgres"/"app" service slot in the default project, even a
# live production container on a completely different volume.
COMPOSE_PROJECT_NAME=machine-learning-comparative-balanced

# Distinct host ports so this environment can run without colliding with the default stack
# (or another comparative environment) still running on the host's usual PORT/DB_PORT.
PORT=3513
DB_PORT=6013

POSTGRES_VOLUME_NAME=recommendation_postgres_balanced
MODEL_VOLUME_NAME=recommendation_models_balanced
EXPERIMENT_VOLUME_NAME=recommendation_reports_balanced

POSTGRES_CONTAINER_NAME=recommendation-ml-postgres-balanced
APP_CONTAINER_NAME=recommendation-ml-app-balanced

TRAINING_ALGORITHM_LOCK=LogisticRegression

EXPERIMENT_ID=comparative-balanced-v1
DATASET_VERSION=comparative-balanced-v1
