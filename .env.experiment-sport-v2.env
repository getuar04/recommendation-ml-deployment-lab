# Comparative experiment A (v2): SPORT-dominant dataset, rigor pass (see README "Comparative
# Experiments" -- fixed generation timestamp, deterministic post-generation class-balance
# stratification, symmetric primary candidate scenario, enforced fail-fast invariants).
#
# Entirely separate identity/isolation from the v1 sport profile (.env.experiment-sport.env):
# different Compose project, different volumes, different ports, different EXPERIMENT_ID.
# v1's volumes/reports are never touched by this profile.
#
#   docker compose --env-file .env --env-file .env.experiment-sport-v2.env up -d
#
# Every value here only *overrides* what .env already sets -- it never replaces .env.

COMPOSE_PROJECT_NAME=machine-learning-comparative-sport-v2

POSTGRES_VOLUME_NAME=recommendation_postgres_sport_v2
MODEL_VOLUME_NAME=recommendation_models_sport_v2
EXPERIMENT_VOLUME_NAME=recommendation_reports_sport_v2

POSTGRES_CONTAINER_NAME=recommendation-ml-postgres-sport-v2
APP_CONTAINER_NAME=recommendation-ml-app-sport-v2

# Distinct from the default stack (3500/6003) and every v1 profile (3510-3513/6010-6013).
PORT=3520
DB_PORT=6020

TRAINING_ALGORITHM_LOCK=LogisticRegression

EXPERIMENT_ID=comparative-sport-v2
DATASET_VERSION=comparative-sport-v2
