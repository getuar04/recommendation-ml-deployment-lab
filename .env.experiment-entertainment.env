# Comparative experiment B: MOVIES/ENTERTAINMENT-dominant dataset (see README "Comparative
# Experiments"). This repository's supported category set has no MOVIES/ENTERTAINMENT
# category -- COMEDY is used as the closest existing supported category (see
# app/experiments/comparative_definitions.py::COMPARATIVE_ENTERTAINMENT).
#
#   docker compose --env-file .env --env-file .env.experiment-entertainment.env up -d
#
# Every value here only *overrides* what .env already sets -- it never replaces .env.

# CRITICAL: a distinct Compose project name -- see the long comment in
# .env.experiment-sport.env. Without this, Compose can silently recreate (replace) whatever
# container already occupies the "postgres"/"app" service slot in the default project, even a
# live production container on a completely different volume.
COMPOSE_PROJECT_NAME=machine-learning-comparative-entertainment

# Distinct host ports so this environment can run without colliding with the default stack
# (or another comparative environment) still running on the host's usual PORT/DB_PORT.
PORT=3511
DB_PORT=6011

POSTGRES_VOLUME_NAME=recommendation_postgres_entertainment
MODEL_VOLUME_NAME=recommendation_models_entertainment
EXPERIMENT_VOLUME_NAME=recommendation_reports_entertainment

POSTGRES_CONTAINER_NAME=recommendation-ml-postgres-entertainment
APP_CONTAINER_NAME=recommendation-ml-app-entertainment

TRAINING_ALGORITHM_LOCK=LogisticRegression

EXPERIMENT_ID=comparative-entertainment-v1
DATASET_VERSION=comparative-entertainment-v1
