# Comparative experiment A: SPORT-dominant dataset (see README "Comparative Experiments").
# Layer this on top of the base .env (which still supplies DB_PASSWORD etc.):
#
#   docker compose --env-file .env --env-file .env.experiment-sport.env up -d
#
# Every value here only *overrides* what .env already sets -- it never replaces .env, so
# DB_PASSWORD/INTERNAL_API_KEY/etc. still come from the one real .env you already have.

# CRITICAL: a distinct Compose project name. Without this, Compose identifies the "postgres"/
# "app" SERVICE SLOTS by (project name, service name) -- NOT by container_name or volume name
# -- so running this profile inside the same default "machine-learning" project would silently
# RECREATE (replace) whatever container already occupies that slot, even a live production
# postgres/app on a completely different volume. Distinct volume names alone are NOT enough.
COMPOSE_PROJECT_NAME=machine-learning-comparative-sport

# Distinct host ports so this environment can run without colliding with the default stack
# (or another comparative environment) still running on the host's usual PORT/DB_PORT.
PORT=3510
DB_PORT=6010

# Isolated named volumes -- never shared with any other experiment or with the default stack.
POSTGRES_VOLUME_NAME=recommendation_postgres_sport
MODEL_VOLUME_NAME=recommendation_models_sport
EXPERIMENT_VOLUME_NAME=recommendation_reports_sport

# Distinct container names so this experiment's containers never collide with the default
# stack's or another experiment's (only matters if you keep more than one stopped-but-present
# at once; Compose still won't run two SETs of containers with the same name concurrently).
POSTGRES_CONTAINER_NAME=recommendation-ml-postgres-sport
APP_CONTAINER_NAME=recommendation-ml-app-sport

# Locks app.ml.trainer.train_models() to exactly one algorithm for every training run in this
# environment -- the Core Experiment Rule for "same algorithm, different dataset".
TRAINING_ALGORITHM_LOCK=LogisticRegression

# Informational only (validated, not required by any endpoint) -- identifies which comparative
# dataset this environment is meant to run.
EXPERIMENT_ID=comparative-sport-v1
DATASET_VERSION=comparative-sport-v1
