# Comparative experiment B (v2): MOVIES/ENTERTAINMENT-dominant dataset, rigor pass (see
# README "Comparative Experiments"). COMEDY is used as the closest existing supported category
# -- see app/experiments/comparative_definitions.py::COMPARATIVE_ENTERTAINMENT.
#
# Entirely separate identity/isolation from the v1 entertainment profile
# (.env.experiment-entertainment.env): different Compose project, different volumes,
# different ports, different EXPERIMENT_ID. v1's volumes/reports are never touched.
#
#   docker compose --env-file .env --env-file .env.experiment-entertainment-v2.env up -d
#
# Every value here only *overrides* what .env already sets -- it never replaces .env.

COMPOSE_PROJECT_NAME=machine-learning-comparative-entertainment-v2

POSTGRES_VOLUME_NAME=recommendation_postgres_entertainment_v2
MODEL_VOLUME_NAME=recommendation_models_entertainment_v2
EXPERIMENT_VOLUME_NAME=recommendation_reports_entertainment_v2

POSTGRES_CONTAINER_NAME=recommendation-ml-postgres-entertainment-v2
APP_CONTAINER_NAME=recommendation-ml-app-entertainment-v2

# Distinct from the default stack (3500/6003) and every v1 profile (3510-3513/6010-6013).
PORT=3521
DB_PORT=6021

TRAINING_ALGORITHM_LOCK=LogisticRegression

EXPERIMENT_ID=comparative-entertainment-v2
DATASET_VERSION=comparative-entertainment-v2
