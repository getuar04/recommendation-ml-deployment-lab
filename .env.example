# PostgreSQL connection used by the application and by `alembic upgrade head`.
#
# Production/dev (PostgreSQL): schema changes are applied only through Alembic migrations
# (`alembic upgrade head`) -- the app's own `Base.metadata.create_all()` does NOT run
# against this URL. See README "Setup" for the fresh-database vs. existing-pre-Alembic-
# database (stamp/adopt) workflows -- they are different and the adoption path requires a
# manual schema check first, never an unconditional `alembic stamp`.
#
# Tests (SQLite): tests force DATABASE_URL=sqlite:// before importing the app (see
# tests/conftest.py) and rely on Base.metadata.create_all()/drop_all() directly -- Alembic
# is not involved in the test path at all.
DATABASE_URL=postgresql+psycopg://recommendation_user:change-me@localhost:5432/recommendation_ml
MODEL_DIR=./models

# GET /health metadata (app.core.config / app.api.health_routes). SERVICE_NAME/SERVICE_VERSION
# have sane defaults (matching this service's own name/version) so an unconfigured checkout
# still reports something meaningful. SERVICE_COMMIT/SERVICE_BUILD_TIME have no meaningful
# default outside a real build -- leave them unset here; a real deployment supplies both as
# Docker build args (see Dockerfile) or CI-exported environment variables, e.g.:
#   SERVICE_COMMIT="$(git rev-parse HEAD)"
#   SERVICE_BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# An unset value reports the honest "unknown" -- never a fabricated hash or timestamp.
# SERVICE_NAME=recommendation-ml-service
# SERVICE_VERSION=1.0.0
# SERVICE_COMMIT=
# SERVICE_BUILD_TIME=
#
# "environment" in the /health response is intentionally sourced from APP_ENV below, not a
# separate ENVIRONMENT variable -- see APP_ENV's own comment.

# Spec §26/§27: recommendation-strategy tiers by a user's prior interaction count, not
# hard-coded anywhere in app/services/recommendation_service.py.
#   0 interactions                            -> COLD_START
#   1 .. PERSONALISED_..._MIN_INTERACTIONS-1  -> HYBRID
#   >= PERSONALISED_..._MIN_INTERACTIONS      -> PERSONALISED_ML
PERSONALISED_RECOMMENDATION_MIN_INTERACTIONS=10
USER_PROFILE_MIN_INTERACTIONS=1

# Migration commands (run with the project venv active, or via
# `docker compose run --rm app python -m alembic <command>` inside the container):
#   alembic upgrade head        apply all pending migrations
#   alembic downgrade -1        roll back the most recent migration
#   alembic current             show the currently-applied revision
#   alembic history             list all revisions in order
#   alembic check               fail if models and the migration head have drifted

# Group C: a training lock older than this (no successful heartbeat/release) is treated as
# abandoned and reclaimed rather than blocking training forever.
TRAINING_STALE_LOCK_SECONDS=1800

# Phase A: deployment mode. "local" (default) and "test" (auto-inferred whenever
# DATABASE_URL is sqlite, regardless of this value) may run without DATABASE_URL set (a
# local-development default is used instead). Any other value (e.g. staging, production)
# makes DATABASE_URL required -- the app raises at import time and refuses to start without
# it, rather than silently falling back to a local-development database.
# APP_ENV=local

# No inbound X-Internal-API-Key gate exists any more -- no route on this service requires it.
# INTERNAL_API_KEY is kept only as an OPTIONAL value: if set, app/services/service_clients.py
# sends it as the X-Internal-API-Key header on OUTBOUND calls to User Behavior
# Service/Candidate Service, which independently still enforce it on their side (see README
# "Service-to-service auth"). Left unset here on purpose -- no default secret is ever invented.
# INTERNAL_API_KEY=

# Phase A: VIDEO ranking hot-path history bound (row count) and inbound candidate/stream
# array size bound. Defaults are starting points pending real traffic data, not measured
# production-scale numbers.
# RECOMMENDATION_HISTORY_MAX_INTERACTIONS=500
# RECOMMENDATION_MAX_CANDIDATES=200

# Correlation-id header name. Accepted from an incoming request if it looks safe (ASCII
# letters/digits/._- , 1-128 chars) and echoed back on every response, success or error;
# an invalid or oversized incoming value is replaced with a freshly generated one rather
# than failing the request. Every structured error response also includes it in the body
# as "requestId".
REQUEST_ID_HEADER=X-Request-ID

# Session 4 (spec §44-47): experiment configuration. Switching experiments never requires a
# code change -- everything below is environment-driven. See README "Experiments" for the
# full explanation, the three experiment definitions, and how to run one.
#
# Where experiment JSON reports are written/read (never model binaries -- those stay in
# MODEL_DIR). In Docker this is the separate /app/experiments mount (its own volume, never
# shared with Postgres data or model artifacts).
EXPERIMENT_DIR=./experiments
#
# Optional: only meaningful while actually running a named experiment
# (`python -m scripts.run_experiment --experiment <id>`). Validated (letters/digits/_/-,
# 1-64 chars) if set; leave unset for normal API/application operation.
# EXPERIMENT_ID=
# DATASET_VERSION=
#
# Docker named-volume identity. Defaults below are the EXACT names Compose already resolves
# for this project with no override -- they must stay in sync with the real deployment's
# actual volumes (verify with `docker compose config` before ever changing a default).
# Overriding one of these to point at a *different* dataset/model set is safe by itself, but
# changing only POSTGRES_VOLUME_NAME (or only MODEL_VOLUME_NAME) without the matching other
# one can pair a database's interaction history with a model artifact trained on different
# data (or vice versa) -- change them together, deliberately, as a matched pair.
POSTGRES_VOLUME_NAME=machine-learning_postgres_data
MODEL_VOLUME_NAME=machine-learning_model_data
EXPERIMENT_VOLUME_NAME=machine-learning_experiment_data

# Comparative Experiments ("same algorithm, different datasets" -- see README "Comparative
# Experiments"). Locks app.ml.trainer.train_models() to exactly one named algorithm
# ("LogisticRegression" or "RandomForestClassifier") for every training run in this
# environment, instead of automatically comparing both. Left unset here on purpose: normal
# training (and every other endpoint) is completely unaffected. Only set this in one of the
# four .env.experiment-*.env files, layered on top of this .env via
# `docker compose --env-file .env --env-file .env.experiment-sport.env ...` -- never set it
# directly in the real deployment's .env.
# TRAINING_ALGORITHM_LOCK=

# Dual-mode real-service integration (see app/services/providers/ and README "Boundary with
# the real platform"). LOCAL (default) is the existing, fully-local demo/test behavior --
# nothing below this line has any effect unless RECOMMENDATION_DATA_MODE=REAL. REAL lets
# recommend() source user behavior/candidates from real services when the caller doesn't
# already supply request.userProfile/request.candidates itself.
# RECOMMENDATION_DATA_MODE=LOCAL

# User Behavior Service client. Unset UBS_BASE_URL means "not configured" -- no production
# URL is invented here; a real deployment must supply its own. Real-contract search result
# (see README "Real-service contract verification"): no User Behavior Service repository,
# OpenAPI doc, or Postman collection exists anywhere in the local Soft Dome workspace, so this
# base URL/path cannot currently be verified against real code -- only the request/response
# SHAPE (app.schemas.recommendation_schemas.UserProfile) is established. On failure,
# UBS_FALLBACK_TO_LOCAL (default true) falls back to this project's own local interactions
# table instead of failing the request.
# UBS_BASE_URL=
# UBS_TIMEOUT_MS=1000
# UBS_FALLBACK_TO_LOCAL=true

# Candidate Service client. Same "unset == unconfigured" rule, and same real-contract search
# result (no such repository/contract found locally either), as UBS_BASE_URL above. On
# failure, falls back to request.candidates when the caller supplied any; otherwise the
# request fails with a clear 503 CANDIDATE_SERVICE_UNAVAILABLE.
# CANDIDATE_SERVICE_BASE_URL=
# CANDIDATE_SERVICE_TIMEOUT_MS=1000

# Service-to-service auth for the two outbound clients above: reuses INTERNAL_API_KEY/
# X-Internal-API-Key (already configured further up this file) -- confirmed, not assumed, to
# be this platform's real internal-auth convention: follow-service's own
# internalAuthMiddleware (src/infra/http/middleware/authMiddleware.ts) gates a
# service-to-service route with the exact same INTERNAL_API_KEY env var name and
# x-internal-api-key header. No separate variable is needed here.

# Optional Kafka behavioral-event consumer (see app/services/kafka_behavior_consumer.py). OFF
# by default -- local/demo/test operation never needs Kafka, and an unreachable broker never
# blocks startup or breaks POST /events. Requires a Kafka client library to be installed
# separately (not a hard dependency of this project's requirements.txt).
# KAFKA_BROKERS/KAFKA_BEHAVIOR_GROUP_ID naming (not KAFKA_BOOTSTRAP_SERVERS) matches the real,
# confirmed convention every Kafka-consuming sibling service in this workspace uses
# (follow-service/.env.example: KAFKA_BROKERS, KAFKA_CLIENT_ID, KAFKA_<DOMAIN>_GROUP_ID,
# KAFKA_TOPIC_<NAME>). No event-tracking-service repository or topic list for THIS domain
# (VIDEO watch/completion signals) was found locally, so KAFKA_BEHAVIOR_TOPIC has no default
# and must be set explicitly -- the consumer refuses to start without it (see that module).
# KAFKA_BEHAVIOR_ENABLED=false
# KAFKA_BROKERS=
# KAFKA_BEHAVIOR_TOPIC=
# KAFKA_BEHAVIOR_GROUP_ID=recommendation-ml-service
